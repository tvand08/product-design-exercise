<div class="card h-100" data-post-card="<%= post.id %>">
  <div class="card-body d-flex flex-column position-relative">
    <h5 class="card-title me-1"><%= link_to post.title, post, class: "text-decoration-none" %></h5>
    <p class="card-text text-muted flex-grow-1"><%= truncate(post.body, length: local_assigns.fetch(:body_length, 120)) %></p>
    <div class="d-flex">
      <small class="text-muted mt-auto flex-grow-1"><%= time_ago_in_words(post.created_at) %> ago</small>
      <%= render "posts/bookmark_label", post: post %>
    </div>
    <div class="position-absolute top-0 end-0 m-2 z-3">
      <%= render "posts/bookmark_button", post: post %>
    </div>
  </div>
</div>
