<div class="mb-4">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <h1><%= @post.title %></h1>
    <%= render "posts/bookmark_button", post: @post %>
  </div>

  <p class="text-muted"><%= time_ago_in_words(@post.created_at) %> ago</p>

  <div class="mb-4" style="white-space: pre-wrap;"><%= @post.body %></div>

  <div class="d-flex align-items-center gap-2">
    <div class="flex-grow-1 d-flex" >
      <%= link_to "Edit", edit_post_path(@post), class: "btn btn-outline-secondary me-1" %>
      <%= button_to "Delete", @post, method: :delete, class: "btn btn-outline-danger me-1",
          data: { turbo_confirm: "Are you sure you want to delete this post?" } %>
      <%= link_to "Back to Posts", posts_path, class: "btn btn-outline-primary me-1" %>
    </div>
    <%= render "posts/bookmark_label", post: @post %>
  </div>
</div>
