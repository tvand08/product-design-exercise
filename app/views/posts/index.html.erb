<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Posts</h1>
  <%= link_to "New Post", new_post_path, class: "btn btn-primary" %>
</div>

<div class="row g-4">
  <% @posts.each do |post| %>
    <div class="col-12">
      <%= render "posts/post_card", post: post, body_length: 200 %>
    </div>
  <% end %>
</div>
