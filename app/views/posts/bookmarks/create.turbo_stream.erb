<%= turbo_stream.replace dom_id(@post, :bookmark) do %>
  <%= render "posts/bookmark_button_created", post: @post %>
<% end %>

<%= turbo_stream.remove "bookmarked_posts_empty" %>

<%= turbo_stream.append "bookmarked_posts" do %>
  <li id="<%= dom_id(@post, :bookmarked) %>" class="col-md-4" data-id="<%= @post.id %>">
    <%= render "posts/post_card", post: @post %>
  </li>
<% end %>
