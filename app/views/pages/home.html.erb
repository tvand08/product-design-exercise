<div class="text-center mb-4">
  <small class="text-uppercase text-muted fw-semibold letter-spacing-wide">Strety</small>
  <h2 class="fw-bold mt-1 mb-4">Community Board</h2>
  <div class="hstack justify-content-center">
    <div class="hstack gap-2 border rounded-pill px-4 py-3 bg-white lh-1">
      <span class="fw-bold fs-5"><%= @total_posts %></span>
      <span class="text-muted"><%= "Message".pluralize(@total_posts) %> Shared</span>
    </div>
  </div>
</div>

<hr class="mb-4">

<h5 class="mb-3 text-muted fw-semibold">Recent Posts</h5>

<div class="row g-4">
  <% @recent_posts.each do |post| %>
    <div class="col-md-4">
      <%= render "posts/post_card", post: post %>
    </div>
  <% end %>
</div>

<h5 class="mt-5 mb-3 text-muted fw-semibold">Bookmarked Posts</h5>

<ul id="bookmarked_posts" class="row g-4 list-unstyled" data-controller="sorting" data-position-url="">
  <% @bookmarked_posts.each do |post| %>
    <li id="<%= dom_id(post, :bookmarked) %>" class="col-md-4" data-id="<%= post.id %>">
      <%= render "posts/post_card", post: post %>
    </li>
  <% end %>
  <% if @bookmarked_posts.empty? %>
    <li id="bookmarked_posts_empty" class="col-12">
      <p class="text-muted fst-italic">No bookmarked posts yet.</p>
    </li>
  <% end %>
</ul>
